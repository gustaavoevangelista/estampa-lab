# Copy to .env and fill in. Never commit .env.

# Supabase Postgres (Project → Connect → ORMs → Prisma). Replace [PROJECT-REF], [PASSWORD] and [REGION].
# App queries: transaction pooler, port 6543
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: session pooler, port 5432
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Auth.js secret. Generate with:  npx auth secret   (or any 32+ random chars)
AUTH_SECRET="change-me"
# Needed when running `npm start` locally / behind a proxy
AUTH_TRUST_HOST=true

# First owner account created by `npm run db:seed`
SEED_OWNER_EMAIL="admin@estampalab.pt"
SEED_OWNER_PASSWORD="change-me-now"
SEED_OWNER_NAME="Gustavo"

# File uploads: "local" (dev) or "s3" (S3 / Cloudflare R2, later)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
